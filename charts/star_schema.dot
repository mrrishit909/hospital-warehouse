digraph S {
  graph [bgcolor="#0b0b0b", rankdir=LR, nodesep=0.5, ranksep=1.1];
  node [shape=plaintext, fontname="Helvetica", fontcolor="#f2f2f0"];
  edge [color="#8a8a87", fontname="Helvetica", fontsize=10, fontcolor="#8a8a87", arrowhead=none];
  dim_date [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#3a3a3a" bgcolor="#141414"><tr><td colspan="3" bgcolor="#1f3b5c"><b>dim_date</b></td></tr><tr><td align="left" port="date_key_w">date_key</td><td align="left"><font color="#8a8a87">date</font></td><td align="left" port="date_key_e"> </td></tr><tr><td align="left" port="year_w">year</td><td align="left"><font color="#8a8a87">smallint</font></td><td align="left" port="year_e"> </td></tr><tr><td align="left" port="quarter_w">quarter</td><td align="left"><font color="#8a8a87">tinyint</font></td><td align="left" port="quarter_e"> </td></tr><tr><td align="left" port="release_no_w">release_no</td><td align="left"><font color="#8a8a87">smallint</font></td><td align="left" port="release_no_e"> </td></tr></table>>];
  dim_hospital [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#3a3a3a" bgcolor="#141414"><tr><td colspan="3" bgcolor="#1f3b5c"><b>dim_hospital</b></td></tr><tr><td align="left" port="hospital_sk_w">hospital_sk</td><td align="left"><font color="#8a8a87">integer</font></td><td align="left" port="hospital_sk_e"><font color="#d9a35f">surrogate key</font></td></tr><tr><td align="left" port="hospital_key_w">hospital_key</td><td align="left"><font color="#8a8a87">integer</font></td><td align="left" port="hospital_key_e"><font color="#d9a35f">durable key</font></td></tr><tr><td align="left" port="facility_id_w">facility_id</td><td align="left"><font color="#8a8a87">varchar</font></td><td align="left" port="facility_id_e"><font color="#d9a35f">business key (CMS ID)</font></td></tr><tr><td align="left" port="name_w">name</td><td align="left"><font color="#8a8a87">varchar</font></td><td align="left" port="name_e"><font color="#d9a35f">Type 1</font></td></tr><tr><td align="left" port="address_w">address</td><td align="left"><font color="#8a8a87">varchar</font></td><td align="left" port="address_e"> </td></tr><tr><td align="left" port="city_w">city</td><td align="left"><font color="#8a8a87">varchar</font></td><td align="left" port="city_e"> </td></tr><tr><td align="left" port="state_w">state</td><td align="left"><font color="#8a8a87">varchar</font></td><td align="left" port="state_e"> </td></tr><tr><td align="left" port="zip_w">zip</td><td align="left"><font color="#8a8a87">varchar</font></td><td align="left" port="zip_e"> </td></tr><tr><td align="left" port="county_w">county</td><td align="left"><font color="#8a8a87">varchar</font></td><td align="left" port="county_e"> </td></tr><tr><td align="left" port="hospital_type_w">hospital_type</td><td align="left"><font color="#8a8a87">varchar</font></td><td align="left" port="hospital_type_e"><font color="#d9a35f">Type 2</font></td></tr><tr><td align="left" port="ownership_w">ownership</td><td align="left"><font color="#8a8a87">varchar</font></td><td align="left" port="ownership_e"><font color="#d9a35f">Type 2</font></td></tr><tr><td align="left" port="emergency_services_w">emergency_services</td><td align="left"><font color="#8a8a87">boolean</font></td><td align="left" port="emergency_services_e"><font color="#d9a35f">Type 2</font></td></tr><tr><td align="left" port="valid_from_w">valid_from</td><td align="left"><font color="#8a8a87">date</font></td><td align="left" port="valid_from_e"><font color="#d9a35f">SCD dates</font></td></tr><tr><td align="left" port="valid_to_w">valid_to</td><td align="left"><font color="#8a8a87">date</font></td><td align="left" port="valid_to_e"><font color="#d9a35f">SCD dates</font></td></tr><tr><td align="left" port="is_current_w">is_current</td><td align="left"><font color="#8a8a87">boolean</font></td><td align="left" port="is_current_e"> </td></tr><tr><td align="left" port="change_reason_w">change_reason</td><td align="left"><font color="#8a8a87">varchar</font></td><td align="left" port="change_reason_e"> </td></tr></table>>];
  fact_rating [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#3a3a3a" bgcolor="#141414"><tr><td colspan="3" bgcolor="#4a2414"><b>fact_rating</b></td></tr><tr><td align="left" port="date_key_w">date_key</td><td align="left"><font color="#8a8a87">date</font></td><td align="left" port="date_key_e"> </td></tr><tr><td align="left" port="hospital_sk_w">hospital_sk</td><td align="left"><font color="#8a8a87">integer</font></td><td align="left" port="hospital_sk_e"> </td></tr><tr><td align="left" port="hospital_key_w">hospital_key</td><td align="left"><font color="#8a8a87">integer</font></td><td align="left" port="hospital_key_e"> </td></tr><tr><td align="left" port="overall_rating_w">overall_rating</td><td align="left"><font color="#8a8a87">tinyint</font></td><td align="left" port="overall_rating_e"> </td></tr></table>>];
  hospital_lineage [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#3a3a3a" bgcolor="#141414"><tr><td colspan="3" bgcolor="#2a2a2a"><b>hospital_lineage</b></td></tr><tr><td align="left" port="old_facility_id_w">old_facility_id</td><td align="left"><font color="#8a8a87">varchar</font></td><td align="left" port="old_facility_id_e"> </td></tr><tr><td align="left" port="new_facility_id_w">new_facility_id</td><td align="left"><font color="#8a8a87">varchar</font></td><td align="left" port="new_facility_id_e"> </td></tr><tr><td align="left" port="rule_w">rule</td><td align="left"><font color="#8a8a87">varchar</font></td><td align="left" port="rule_e"> </td></tr><tr><td align="left" port="old_name_w">old_name</td><td align="left"><font color="#8a8a87">varchar</font></td><td align="left" port="old_name_e"> </td></tr><tr><td align="left" port="new_name_w">new_name</td><td align="left"><font color="#8a8a87">varchar</font></td><td align="left" port="new_name_e"> </td></tr><tr><td align="left" port="city_w">city</td><td align="left"><font color="#8a8a87">varchar</font></td><td align="left" port="city_e"> </td></tr><tr><td align="left" port="state_w">state</td><td align="left"><font color="#8a8a87">varchar</font></td><td align="left" port="state_e"> </td></tr></table>>];
  dim_date:date_key_e:e -> fact_rating:date_key_w:w;
  fact_rating:hospital_sk_e:e -> dim_hospital:hospital_sk_w:w;
  dim_hospital:facility_id_e:e -> hospital_lineage:old_facility_id_w:w [style=dashed, label="ID changes"];
}
